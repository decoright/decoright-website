# Copy to .env and fill in. .env is gitignored.
#
# Vite inlines every variable prefixed with VITE_ into the JavaScript bundle
# served to the browser. Only put values here that are safe to be public.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The client-side key. Supabase renamed this from "anon" to "publishable";
# src/lib/supabase.ts accepts either name.
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key


# ---------------------------------------------------------------------------
# NOT a frontend variable.
#
# RESEND_API_KEY belongs in Supabase, not here. The send-auth-email edge
# function reads it server side:
#
#   supabase secrets set RESEND_API_KEY="re_..."
#
# It is listed only as a reminder. Nothing in src/ reads it, and it must never
# be renamed with a VITE_ prefix, which would publish it to every visitor.
# See supabase/functions/README.md.
# ---------------------------------------------------------------------------
